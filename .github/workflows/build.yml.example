name: Build and Test

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main, develop ]

jobs:
  build:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Install dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            build-essential \
            cmake \
            libsdl2-dev \
            libsdl2-image-dev \
            libsidplayfp-dev \
            pkg-config
      
      - name: Configure CMake
        run: |
          mkdir -p build
          cd build
          cmake ..
        env:
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_ANON_KEY: ${{ secrets.SUPABASE_ANON_KEY }}
      
      - name: Build
        run: |
          cd build
          make -j$(nproc)
      
      - name: Run tests
        run: |
          cd build
          ./bin/supabase_test || true
          ./bin/supabase_tests || true
